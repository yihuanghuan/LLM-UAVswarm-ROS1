<!--
  实机测试启动文件 (ROS1 + MAVROS + VRPN 动捕)
  用法:
    单机: roslaunch ladrc_controller real_hardware.launch uav_id:=1
    多机: roslaunch ladrc_controller real_hardware.launch uav_id:=1 uav_id_2:=2 ...

  架构:
    Nokov 动捕 (10.1.1.198) → VRPN (3883) → vrpn_client_ros
      → /vrpn_client_node/uav<N>/pose
      → vrpn_vision_relay → /uav<N>/mavros/vision_pose/pose → PX4 EKF2
    LADRC 控制器 → MAVROS setpoint_position/local → PX4 Offboard

  ESP32 Wi-Fi 桥接 (TCP MAVLink):
    fcu_url:=tcp://10.1.1.61:5760
  串口直连模式:
    fcu_url:=/dev/ttyACM0:921600
-->
<launch>
  <!-- ==================== 参数 ==================== -->
  <arg name="uav_id" default="1" doc="无人机编号 (1-10)"/>
  <arg name="vrpn_server_ip" default="10.1.1.198" doc="Nokov 动捕主机 IP 地址"/>
  <arg name="vrpn_port" default="3883" doc="VRPN 服务器端口 (Nokov 默认)"/>
  <arg name="vrpn_rigid_body" default="uav" doc="VRPN 刚体名称前缀 (会自动拼接编号, 如 uav1, uav2...)"/>
  <arg name="fcu_url" default="tcp://10.1.1.61:5760" doc="飞控 MAVLink 地址 (ESP32 TCP 默认端口 5760)"/>
  <arg name="use_vision" default="true" doc="true=启用VRPN动捕视觉, false=仅用飞控内部IMU/GPS"/>
  <arg name="ladrc_config" default="$(find ladrc_controller)/config/real_hardware_params.yaml" doc="LADRC 参数文件"/>

  <group ns="uav$(arg uav_id)">
    <!-- ==================== VRPN 客户端 (接收 Nokov 动捕数据) ==================== -->
    <node if="$(arg use_vision)" name="vrpn_client_ros" pkg="vrpn_client_ros" type="vrpn_client_node" output="screen">
      <param name="server" value="$(arg vrpn_server_ip)" />
      <param name="port" value="$(arg vrpn_port)" />
    </node>

    <!-- ==================== VRPN → MAVROS Vision 转发 ==================== -->
    <!-- 将 /vrpn_client_node/<rigid_body>/pose 转发到 /uav1/mavros/vision_pose/pose -->
    <node if="$(arg use_vision)" name="vrpn_vision_relay" pkg="ladrc_controller" type="vrpn_vision_relay.py" output="screen">
      <param name="vrpn_topic" value="/vrpn_client_node/$(arg vrpn_rigid_body)$(arg uav_id)/pose" />
      <param name="vision_topic" value="mavros/vision_pose/pose" />
    </node>

    <!-- ==================== MAVROS ==================== -->
    <node name="mavros" pkg="mavros" type="mavros_node" output="screen">
      <param name="fcu_url" value="$(arg fcu_url)" />
      <param name="gcs_url" value="" />
      <param name="target_system_id" value="$(arg uav_id)" />
      <param name="target_component_id" value="1" />
    </node>

    <!-- ==================== LADRC 控制节点 ==================== -->
    <node name="ladrc_position_controller" pkg="ladrc_controller" type="ladrc_position_controller_node" output="screen">
      <rosparam file="$(arg ladrc_config)" command="load" />
      <param name="enu_offset_x" value="0.0" />
      <param name="enu_offset_y" value="0.0" />
      <param name="enu_offset_z" value="0.0" />
      <param name="neighbor_offset_multiplier" value="0.0" />
    </node>
  </group>
</launch>
